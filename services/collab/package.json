{
  "name": "@agentnote/collab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hocuspocus realtime server for agentnote note documents",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/index.mjs",
    "start": "node dist/index.mjs",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.11.5",
    "@hocuspocus/extension-database": "4.4.0",
    "@hocuspocus/server": "4.4.0",
    "pg": "^8.22.0",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}

DATABASE_URL=postgres://user:password@host:5432/agentnote

# Vercel Cron: Bearer token for every /api/cron/* route
CRON_SECRET=

# Note body as a Yjs CRDT instead of whole-document PUT (see README).
# 1 enables it. Notes are seeded server-side on first open and stay CRDT-managed.
NEXT_PUBLIC_AGENTNOTE_CRDT=0

# Realtime (Hocuspocus) server for the CRDT path. Unset keeps HTTP + poll.
# Local dev: ws://localhost:1234 alongside `pnpm collab:dev`.
NEXT_PUBLIC_AGENTNOTE_COLLAB_URL=

# --- services/collab only (not read by the Next app) ---
# DATABASE_URL and CLERK_SECRET_KEY above are reused.
# Optional comma-separated origin allowlist for realtime connections.
# AGENTNOTE_ALLOWED_ORIGINS=https://memo.chasehuh.com

# Clerk (new "agentnote" application — do not reuse sume.com / sume.so apps)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
# After GitHub SSO (when no redirect_url is present) — Clerk BP
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Optional: Obsidian/Notion-style image paste → R2/CDN Markdown
# MEDIA_UPLOAD_URL=https://chasehuh-media-upload.example.workers.dev
# MEDIA_UPLOAD_SECRET=shared-secret-with-upload-worker
